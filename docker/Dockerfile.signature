# Quantum-Safe Git (QSGit) – Signature Service Dockerfile
FROM golang:1.21-alpine AS builder

WORKDIR /src
COPY go/ .
RUN go mod download
RUN go build -o /qsg-signature-service .

FROM alpine:3.18

WORKDIR /app
COPY --from=builder /qsg-signature-service /app/qsg-signature-service

EXPOSE 50051
ENTRYPOINT ["/app/qsg-signature-service"]
