" QSGit - SpaceVim / Neovim editor configuration
set runtimepath^=/workspace
set scrolloff=8
set number
set relativenumber
set tabstop=4
set shiftwidth=4
set expandtab
set smartindent
set wrap
set linebreak
set incsearch
set hlsearch
set cursorline
set background=dark
let g:editorconfig_enabled = 1
set signcolumn=yes
set colorcolumn=80
